{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AI Company",
  "version": "0.1.0",
  "identifier": "local.ai-company.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "AI Company",
        "width": 1280,
        "height": 820,
        "minWidth": 960,
        "minHeight": 640
      }
    ]
  },
  "bundle": {
    "active": false,
    "targets": "all"
  }
}
